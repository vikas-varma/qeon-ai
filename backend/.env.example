QEON_APP_NAME=Qeon AI API
QEON_ENVIRONMENT=development
QEON_DEBUG=true
QEON_API_PREFIX=/api/v1
QEON_DATABASE_URL=postgresql+asyncpg://qeonai:qeonai_dev_password@postgres:5432/qeonai
QEON_REDIS_URL=redis://redis:6379/0
QEON_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
QEON_AI_PROVIDER=mock
QEON_OPENAI_API_KEY=
QEON_GEMINI_API_KEY=
QEON_GEMINI_MODEL=gemini-3.5-flash-lite
QEON_FIREBASE_PROJECT_ID=
QEON_JWT_AUDIENCE=qeonai
# Google Cloud OAuth "Web application" credentials. Never commit real values.
QEON_GOOGLE_CLIENT_ID=
QEON_GOOGLE_CLIENT_SECRET=
QEON_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QEON_TOKEN_ENCRYPTION_KEY=
